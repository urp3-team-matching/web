# Local dev defaults. Copy to .env and adjust if needed:
#   cp .env.example .env
#
# All values below are correct for `pnpm dev:setup` (local Supabase via CLI),
# except NEXT_PUBLIC_SUPABASE_ANON_KEY which is regenerated per machine.
# Run `pnpm exec supabase status` after `dev:setup` to grab the actual key.

# ===== Supabase (local stack) =====
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxx

# ===== Prisma (Supabase local Postgres — pooler disabled, both URLs identical) =====
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ===== Email (Gmail SMTP) =====
# Local: dummy values — lib/email/index.ts retries 3x then logs console.error, app keeps running.
# Production: real Gmail address + app password.
EMAIL_SERVER_USER=dev@local.test
EMAIL_SERVER_PASSWORD=dummy
